# ==============================================================================
# Frontend Git Ignore Rules (.gitignore)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/

# Environment files and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.oxlintrc.json
