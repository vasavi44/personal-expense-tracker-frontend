# Backend REST API Base URL
# For local development with Spring Boot running on port 8080:
VITE_API_BASE_URL=http://localhost:8080/api

# For production deployment (configure in Vercel project environment variables):
# VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
